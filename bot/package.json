{
  "name": "drbot",
  "version": "0.1.0",
  "author": "Dr. Kevin",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.8",
    "boolean": "^3.2.0",
    "chokidar": "^5.0.0",
    "discord-api-types": "^0.38.37",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "format-duration": "^3.0.2",
    "mime": "^4.1.0",
    "music-metadata": "^11.10.3",
    "p-queue": "^9.0.1",
    "redis": "^5.10.0",
    "sodium-native": "^5.0.10",
    "web-streams-polyfill": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/bun": "^1.3.4",
    "@types/jest": "~29.5",
    "concurrently": "^9.2.1",
    "jest": "~29.7",
    "rimraf": "~6.1",
    "ts-api-utils": "~2.1",
    "ts-jest": "~29.4",
    "typescript": "~5.4.5"
  },
  "description": "Discord music bot for local files",
  "keywords": ["discord", "music", "bot", "local", "audio", "voice"],
  "license": "GPL-3.0+",
  "private": true,
  "scripts": {
    "start": "bun build/src/main.js",
    "clean": "rimraf coverage build tmp",
    "prebuild": "bun run lint",
    "build": "bun build src/main.ts --compile --outfile build/output",
    "lint": "bunx --bun biome format .",
    "test": "bunx --bun jest --coverage",
    "test:watch": "bunx --bun jest --watch"
